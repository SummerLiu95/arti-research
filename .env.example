# 数据库（docker-compose 内服务名；本地开发可用 localhost:5432）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/arti

# LLM 抽取使用的模型与密钥（仓库不含真实凭据，本地自行填入 .env）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

# 前端开发代理目标
VITE_API_BASE_URL=http://localhost:8000
